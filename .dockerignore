# Keep the build context small. Anything listed here is never sent to the
# Docker daemon or to Cloud Build, which speeds up builds and keeps the image
# free of files it has no use for.

node_modules
dist
.angular
.git
.gitignore
.github
.vscode

# Stage scripts and the AWS comparison are not part of the Cloud Run image.
demo
lambda

*.md
*.pptx
cloudbuild.yaml
Dockerfile
.dockerignore
.editorconfig
.prettierrc
